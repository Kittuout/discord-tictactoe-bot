# Environment Variables Template
# Copy this file to .env and fill in your Discord credentials

# Discord Bot Token
# Get this from: Discord Developer Portal > Your App > Bot > TOKEN
DISCORD_TOKEN=your_bot_token_here

# Discord Client ID
# Get this from: Discord Developer Portal > Your App > General Information > CLIENT ID
CLIENT_ID=your_client_id_here

# Discord Guild ID (Optional)
# Use for faster command registration during testing
# Get this by: Right-click server > Copy Server ID
# Remove this line for global command registration
# GUILD_ID=your_guild_id_here
